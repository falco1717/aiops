[Unit]
# The @PLACEHOLDER@ values are filled in by install.sh. This file is the one
# copy of the unit, so what is reviewed here is what ends up on the machine.
Description=AIOps relay node (jump point for agents running on the AIOps server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_USER@
EnvironmentFile=@CONF_DIR@/node.env
ExecStart=@PYTHON@ @PREFIX@/aiops_relay_node.py
# on-failure, not always. The agent runs until it is stopped or until AIOps
# tells it that this node has been revoked, and the second of those is a clean
# exit. Restarting that would put a withdrawn node into a reconnect loop
# forever, which is both useless and noisy on somebody else's network.
# Exit 2 is a configuration error — no URL, no credential — and restarting on
# a loop will not fix it either.
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5

# The agent opens outbound TCP connections and copies bytes. None of the
# following is load-bearing for that, which is exactly why it is all on: if a
# future change to the agent starts needing one of these off, that is a change
# worth noticing.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@STATE_DIR@

# Everything the node is asked to connect to is logged to the journal under
# this unit's name, readable by anyone on this machine who can read the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
