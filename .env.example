# Copy to .env and fill in. The two secrets below are required to start.

# --- database ---------------------------------------------------------
POSTGRES_USER=aiops
POSTGRES_PASSWORD=
POSTGRES_DB=aiops

# --- app --------------------------------------------------------------
# openssl rand -hex 32
AIOPS_JWT_SECRET=

AIOPS_ADMIN_USERNAME=admin
# Leave blank to have a random password generated and printed to the app log
# on first start (`docker compose logs app`).
AIOPS_ADMIN_PASSWORD=

# Where your repos live on the host. Mounted at /workspaces in the container.
AIOPS_WORKSPACES_HOST_PATH=./workspaces

# How many agents may run at once, and how long any single turn may take.
AIOPS_MAX_CONCURRENT_RUNS=4
AIOPS_RUN_TIMEOUT_SECONDS=3600

AIOPS_SCHEDULER_ENABLED=true

# --- reverse proxy (docker-compose.yml) -------------------------------
# Hostname Traefik routes to this app. Must have a DNS record pointing at the
# host, and the cert resolver must be able to issue for it.
PUBLIC_HOSTNAME=aiops.example.com

# Existing Traefik docker network, created outside this stack.
TRAEFIK_NETWORK=saltbox
TRAEFIK_CERTRESOLVER=cfdns

# Middleware chains. Keep the forward-auth entry (authelia@docker here) unless
# something else is authenticating in front of the app — AIOps can run shell
# commands, so it should never be reachable unauthenticated.
TRAEFIK_MIDDLEWARES=globalHeaders@file,secureHeaders@file,cloudflarewarp@docker,authelia@docker
TRAEFIK_MIDDLEWARES_HTTP=globalHeaders@file,redirect-to-https@docker,cloudflarewarp@docker,authelia@docker

# TLS terminates at Traefik, so the session cookie stays Secure.
AIOPS_COOKIE_SECURE=true

# --- standalone only (docker-compose.local.yml) -----------------------
# host:port the container publishes when running without a proxy.
AIOPS_BIND=127.0.0.1:8080
